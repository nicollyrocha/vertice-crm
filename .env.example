# ─────────────────────────────────────────────────────────────
# Vértice CRM — variáveis de ambiente
# Copie para .env.local (dev) e configure as mesmas na Vercel.
# ─────────────────────────────────────────────────────────────

# Neon Postgres (obrigatório). Use a connection string "pooled".
# Vercel → Storage → Neon cria esta variável automaticamente.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js (obrigatório). Gere com: npx auth secret
AUTH_SECRET=""

# URL pública do app (usada nos links dos emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — emails transacionais (opcional em dev: sem chave, os links saem no console)
RESEND_API_KEY=""
EMAIL_FROM="Vértice <no-reply@seudominio.com.br>"

# Vercel Blob — upload de foto de perfil e logo (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=""

# OAuth opcional — os botões só aparecem se as duas variáveis existirem
# Callback: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google | /github
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
